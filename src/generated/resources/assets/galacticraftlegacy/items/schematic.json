        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "galacticraftlegacy:item/schematic_tier_2"
          },
          "when": "advanced"
        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "galacticraftlegacy:item/schematic_tier_3"
          },
          "when": "ultimate"
        }
      ],
      "property": "galacticraftlegacy:schematic_level"
    },
    "property": "minecraft:has_component"
  }
